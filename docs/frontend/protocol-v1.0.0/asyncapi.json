{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Discovery WebSocket server",
    "version": "1.0.0",
    "description": "Server perspective. Authentication happens in HTTP upgrade through single-use ticket, never in hello. Normative timing and correlation in docs/WEBSOCKET.md."
  },
  "defaultContentType": "application/json",
  "servers": {
    "lan": {
      "host": "discovery.lan",
      "protocol": "wss",
      "description": "Same trusted origin as HTTP; discovery.v1 subprotocol."
    }
  },
  "channels": {
    "game": {
      "address": "/api/v1/ws",
      "description": "Query ticket from POST ws-ticket; never log ticket. Origin allowlist required.",
      "messages": {
        "client.hello": {
          "$ref": "#/components/messages/client.hello"
        },
        "player.input": {
          "$ref": "#/components/messages/player.input"
        },
        "npc.interact": {
          "$ref": "#/components/messages/npc.interact"
        },
        "npc.cancel": {
          "$ref": "#/components/messages/npc.cancel"
        },
        "world.ready": {
          "$ref": "#/components/messages/world.ready"
        },
        "client.metrics": {
          "$ref": "#/components/messages/client.metrics"
        },
        "client.ping": {
          "$ref": "#/components/messages/client.ping"
        },
        "server.welcome": {
          "$ref": "#/components/messages/server.welcome"
        },
        "world.interest": {
          "$ref": "#/components/messages/world.interest"
        },
        "world.snapshot": {
          "$ref": "#/components/messages/world.snapshot"
        },
        "config.changed": {
          "$ref": "#/components/messages/config.changed"
        },
        "npc.accepted": {
          "$ref": "#/components/messages/npc.accepted"
        },
        "npc.result": {
          "$ref": "#/components/messages/npc.result"
        },
        "npc.cancelled": {
          "$ref": "#/components/messages/npc.cancelled"
        },
        "progress.updated": {
          "$ref": "#/components/messages/progress.updated"
        },
        "server.pong": {
          "$ref": "#/components/messages/server.pong"
        },
        "server.error": {
          "$ref": "#/components/messages/server.error"
        },
        "session.closed": {
          "$ref": "#/components/messages/session.closed"
        }
      },
      "servers": [
        {
          "$ref": "#/servers/lan"
        }
      ]
    }
  },
  "operations": {
    "client_hello": {
      "action": "receive",
      "channel": {
