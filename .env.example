# ===================================================
# DISCOVERY SERVER ENVIRONMENT CONFIGURATION
# ===================================================

# Protocol configuration
# Set USE_HTTPS=true to run the server over HTTPS/WSS
USE_HTTPS=false

# Port to bind (default 8080)
PORT=8080
HOST=0.0.0.0

# SSL Certificate paths (used when USE_HTTPS=true)
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=discovery

# LLM service
LLM_URL=http://127.0.0.1:11434
