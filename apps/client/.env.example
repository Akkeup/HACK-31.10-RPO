# Default is real: same-origin Rust API. Use mock for the standalone in-browser demo.
VITE_TRANSPORT=real
# Real backend only: Vite dev proxy, not exposed to the browser bundle.
# For HTTPS backend set to https://127.0.0.1:8080
DISCOVERY_BACKEND_URL=http://127.0.0.1:8080
# Optional existing room; real mode also offers a login/room form.
VITE_SESSION_ID=
# API and WebSocket use the page's origin. HTTPS pages automatically use WSS.
# Production: npm run build:real; serve dist and proxy /api/* to Rust.
