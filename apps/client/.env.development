# mock: local HTTP/WS server in Vite dev/preview. real: same-origin Rust API.
VITE_TRANSPORT=real
# Real backend only: Vite dev proxy, not exposed to the browser bundle.
# Use https://127.0.0.1:8080 when USE_HTTPS=true
DISCOVERY_BACKEND_URL=http://127.0.0.1:8080
# Optional existing room; real mode also offers a login/room form.
VITE_SESSION_ID=
