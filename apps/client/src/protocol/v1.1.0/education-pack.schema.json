{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.1.0/education-pack.schema.json",
  "type": "object",
  "properties": {
    "module": {
      "type": "object",
      "properties": {
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "subject": {
          "type": "string",
          "enum": [
            "mathematics",
            "informatics",
            "history"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "contentVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "teacherId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "examinerId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "moduleId",
        "subject",
        "title",
        "contentVersion",
        "teacherId",
        "examinerId"
      ],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "module": {
          "type": "object",
          "properties": {
            "moduleId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "subject": {
              "type": "string",
              "enum": [
                "mathematics",
                "informatics",
                "history"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "contentVersion": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "teacherId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "examinerId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "moduleId",
            "subject",
            "title",
            "contentVersion",
            "teacherId",
            "examinerId"
          ],
          "additionalProperties": false
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "heading",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 20
        },
        "keyPoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "module",
        "sections",
        "examples",
        "keyPoints"
      ],
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "object",
            "properties": {
              "questionId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "optionId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "optionId",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "questionId",
              "prompt",
              "options"
            ],
            "additionalProperties": false
          },
          "correctOptionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reviewTopic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "question",
          "correctOptionId",
          "explanation",
          "reviewTopic"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 100
    }
  },
  "required": [
    "module",
    "material",
    "questions"
  ],
  "additionalProperties": false
}
