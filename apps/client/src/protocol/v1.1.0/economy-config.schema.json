{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.1.0/economy-config.schema.json",
  "type": "object",
  "properties": {
    "initialBalanceAura": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "maxBalanceAura": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "currency": {
      "const": "aura"
    }
  },
  "required": [
    "initialBalanceAura",
    "maxBalanceAura",
    "currency"
  ],
  "additionalProperties": false
}
