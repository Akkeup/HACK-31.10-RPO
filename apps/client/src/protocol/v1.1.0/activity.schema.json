{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.1.0/activity.schema.json",
  "$defs": {
    "public": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exploring",
            "learning",
            "seated_quiz",
            "seated_competition"
          ]
        },
        "targetId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "seatId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "targetId",
        "seatId"
      ],
      "additionalProperties": false
    },
    "own": {
      "type": "object",
      "properties": {
        "activity": {
          "$ref": "activity.schema.json#/$defs/public"
        },
        "lessonId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "matchId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "lobbyId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "activity",
        "lessonId",
        "attemptId",
        "matchId",
        "lobbyId",
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
