{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.1.0/progress.schema.json",
  "type": "object",
  "properties": {
    "playerId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "completedKnowledgeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "playerId",
    "revision",
    "completedKnowledgeIds",
    "updatedAt"
  ],
  "additionalProperties": false
}
