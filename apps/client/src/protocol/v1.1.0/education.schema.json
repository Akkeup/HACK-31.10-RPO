{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.1.0/education.schema.json",
  "$defs": {
    "module": {
      "type": "object",
      "properties": {
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "subject": {
          "type": "string",
          "enum": [
            "mathematics",
            "informatics",
            "history"
