{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.1.0/config.schema.json",
  "$defs": {
    "publicWorld": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "worldRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunkSizeM": {
          "type": "integer",
          "minimum": 16,
          "maximum": 128
        },
        "grid": {
          "type": "object",
          "properties": {
            "minX": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "maxX": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "minZ": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "maxZ": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            }
          },
          "required": [
            "minX",
            "maxX",
            "minZ",
            "maxZ"
          ],
          "additionalProperties": false
        },
        "spawn": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "z": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        },
        "timeOfDayHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "weather": {
          "type": "string",
          "enum": [
            "clear",
            "cloudy",
            "rain"
          ]
        },
        "decorDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interestRadiusChunks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "maxResidentChunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [
        "worldId",
        "worldRevision",
        "chunkSizeM",
        "grid",
        "spawn",
        "timeOfDayHours",
        "weather",
        "decorDensity",
        "interestRadiusChunks",
        "maxResidentChunks"
      ],
      "additionalProperties": false
    },
    "publicValues": {
      "type": "object",
      "properties": {
        "world": {
          "$ref": "#/$defs/publicWorld"
        },
        "character": {
          "$ref": "character-config.schema.json"
        },
        "renderDefaults": {
          "$ref": "render-config.schema.json"
        },
        "characterVisualDefaults": {
          "$ref": "character-visual-config.schema.json"
        },
        "firstPersonDefaults": {
          "$ref": "first-person-config.schema.json"
        },
        "gameplay": {
          "$ref": "gameplay-config.schema.json"
        }
      },
      "required": [
        "world",
        "character",
        "renderDefaults",
        "characterVisualDefaults",
        "firstPersonDefaults",
        "gameplay"
      ],
      "additionalProperties": false
    },
    "adminValues": {
      "type": "object",
      "properties": {
        "world": {
          "$ref": "world-config.schema.json"
        },
        "character": {
          "$ref": "character-config.schema.json"
        },
        "renderDefaults": {
          "$ref": "render-config.schema.json"
        },
        "characterVisualDefaults": {
          "$ref": "character-visual-config.schema.json"
        },
        "npcBehavior": {
          "$ref": "npc-behavior-config.schema.json"
        },
        "firstPersonDefaults": {
          "$ref": "first-person-config.schema.json"
        },
        "gameplay": {
          "$ref": "gameplay-config.schema.json"
        },
        "economy": {
          "$ref": "economy-config.schema.json"
        }
      },
      "required": [
        "world",
        "character",
        "renderDefaults",
        "characterVisualDefaults",
        "npcBehavior",
        "firstPersonDefaults",
        "gameplay",
        "economy"
      ],
      "additionalProperties": false
    },
    "publicDocument": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "values": {
          "$ref": "#/$defs/publicValues"
        }
      },
      "required": [
        "revision",
        "values"
      ],
      "additionalProperties": false
    },
    "adminDocument": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "values": {
          "$ref": "#/$defs/adminValues"
        }
      },
      "required": [
        "revision",
        "values"
      ],
      "additionalProperties": false
    }
  }
}
