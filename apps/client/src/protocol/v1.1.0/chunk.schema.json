{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.1.0/chunk.schema.json",
  "type": "object",
  "properties": {
    "worldId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "worldRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "chunkId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "x": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "z": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "modelId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "z": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "yawRad": {
            "type": "number",
            "minimum": -3.141593,
            "maximum": 3.141593
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 5
          },
          "collidable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "modelId",
          "position",
          "yawRad",
          "scale",
          "collidable"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "npcIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "maxItems": 50,
      "uniqueItems": true
    }
  },
  "required": [
    "worldId",
    "worldRevision",
    "chunkId",
    "x",
    "z",
    "objects",
    "npcIds"
  ],
  "additionalProperties": false
}
