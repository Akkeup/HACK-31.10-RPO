{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/2.0.0/streaming.schema.json",
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "model/gltf+json",
            "model/gltf-binary",
            "image/png",
            "image/jpeg",
            "image/ktx2",
            "application/octet-stream",
            "image/svg+xml"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^/api/v2/worlds/[a-z0-9_-]+/assets/[a-f0-9]{64}$"
        }
      },
      "required": [
        "resourceId",
        "sha256",
        "byteSize",
        "mediaType",
        "url"
      ],
      "additionalProperties": false
    },
    "chunkDescriptor": {
      "type": "object",
      "properties": {
        "chunkId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "x": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "z": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "url": {
          "type": "string",
          "pattern": "^/api/v2/worlds/[a-z0-9_-]+/chunks/[a-z0-9_-]+/[a-f0-9]{64}$"
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "chunkId",
        "x",
        "z",
        "sha256",
        "byteSize",
        "url",
        "assetIds"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "worldRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "totalWorldBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cacheBudgetBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accounting": {
          "const": "unique-uncompressed-resource-bytes"
        },
        "maxResourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxChunkBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      },
      "required": [
        "worldId",
        "worldRevision",
        "totalWorldBytes",
        "cacheBudgetBytes",
        "accounting",
        "maxResourceBytes",
        "maxChunkBytes"
      ],
      "additionalProperties": false
    },
    "interest": {
      "type": "object",
      "properties": {
        "worldRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "interestRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chunkDescriptor"
          },
          "minItems": 1,
          "maxItems": 25
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "maxItems": 100
        },
        "requiredBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "worldRevision",
        "interestRevision",
        "chunks",
        "assets",
        "requiredBytes"
      ],
      "additionalProperties": false
    }
  }
}
