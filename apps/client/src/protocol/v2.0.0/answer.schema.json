{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/2.0.0/answer.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "single_choice"
