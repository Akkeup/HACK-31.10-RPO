      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "numeric"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
