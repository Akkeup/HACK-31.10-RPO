        },
        "payload": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "effectiveTick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "publicConfig": {
              "$ref": "config.schema.json#/$defs/publicDocument"
            }
          },
          "required": [
            "revision",
            "effectiveTick",
            "publicConfig"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        },
        "serverSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
