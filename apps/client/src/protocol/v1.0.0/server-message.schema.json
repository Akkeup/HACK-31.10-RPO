          "$ref": "streaming.schema.json#/$defs/interest"
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        },
        "serverSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "payload",
        "serverSeq",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "world.snapshot": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0.0"
        },
        "type": {
          "const": "world.snapshot"
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "interestRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "configRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sessionStatus": {
              "type": "string",
              "enum": [
                "waiting",
                "active",
                "paused"
              ]
            },
            "players": {
              "type": "array",
              "items": {
                "$ref": "entities.schema.json#/$defs/player"
              },
              "maxItems": 5
            },
            "npcs": {
              "type": "array",
              "items": {
                "$ref": "entities.schema.json#/$defs/npc"
              },
              "maxItems": 50
            }
          },
          "required": [
            "tick",
            "interestRevision",
            "configRevision",
            "sessionStatus",
            "players",
            "npcs"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        },
        "serverSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "payload",
        "serverSeq",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "config.changed": {
      "type": "object",
