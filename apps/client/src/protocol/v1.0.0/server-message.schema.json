            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "interaction": {
              "allOf": [
                {
                  "$ref": "interaction.schema.json"
                },
                {
                  "properties": {
                    "status": {
                      "const": "pending"
                    }
                  },
                  "type": "object"
                }
              ]
            }
