{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.invalid/protocol/1.0.0/server-message.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/server.welcome"
    },
    {
      "$ref": "#/$defs/world.interest"
    },
    {
      "$ref": "#/$defs/world.snapshot"
    },
    {
      "$ref": "#/$defs/config.changed"
    },
    {
      "$ref": "#/$defs/npc.accepted"
    },
    {
      "$ref": "#/$defs/npc.result"
    },
    {
      "$ref": "#/$defs/npc.cancelled"
    },
    {
      "$ref": "#/$defs/progress.updated"
    },
    {
      "$ref": "#/$defs/server.pong"
    },
    {
      "$ref": "#/$defs/server.error"
    },
    {
      "$ref": "#/$defs/session.closed"
    }
  ],
  "$defs": {
    "server.welcome": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0.0"
        },
        "type": {
          "const": "server.welcome"
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "format": "uuid"
            },
            "serverInstanceId": {
              "type": "string",
              "format": "uuid"
            },
            "session": {
              "$ref": "http.schema.json#/$defs/session"
            },
            "playerId": {
              "type": "string",
              "format": "uuid"
            },
            "configRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "manifest": {
              "$ref": "streaming.schema.json#/$defs/manifest"
            },
            "heartbeatIntervalMs": {
              "const": 10000
            },
            "heartbeatTimeoutMs": {
              "const": 30000
            }
          },
          "required": [
            "connectionId",
            "serverInstanceId",
            "session",
            "playerId",
            "configRevision",
            "manifest",
            "heartbeatIntervalMs",
            "heartbeatTimeoutMs"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        },
        "serverSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "payload",
        "serverSeq",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "world.interest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0.0"
        },
        "type": {
          "const": "world.interest"
